{
  "name": "lifeos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LifeOS · 手机优先的个人生活节奏管理工具（离线 PWA）",
  "scripts": {
    "gen:icons": "node scripts/gen-icons.mjs",
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "build:gh": "GH_PAGES=1 node node_modules/typescript/bin/tsc -b && GH_PAGES=1 node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --host",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.6.2",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0"
  }
}
